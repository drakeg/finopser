# Local Docker deployment
APP_PORT=8080
BACKEND_PORT=8000

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Docker Compose derives CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS from APP_PORT
# for both localhost and 127.0.0.1. Set these explicitly for non-Compose or deployed use.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=finopser
POSTGRES_USER=finopser
POSTGRES_PASSWORD=replace-me

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
