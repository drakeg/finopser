# Local Docker deployment
APP_PORT=8080
BACKEND_PORT=8000

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Docker Compose uses these values when explicitly set. If omitted, Compose defaults
# both origin lists to localhost and 127.0.0.1 using APP_PORT.
# For LAN access, also add the server hostname/IP to DJANGO_ALLOWED_HOSTS and add
# the matching http://<server-host-or-ip>:<APP_PORT> origin to both lists below.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Billing remains disabled by default. Sprint 14 accepts Stripe test-mode keys only.
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# PostgreSQL
POSTGRES_DB=finopser
POSTGRES_USER=finopser
POSTGRES_PASSWORD=replace-me

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
